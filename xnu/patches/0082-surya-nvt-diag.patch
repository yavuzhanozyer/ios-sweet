+/*
+ * SURYA (Poco X3 NFC) Novatek NVT-ts-spi bring-up, stage 1.
+ *
+ * READ-ONLY diagnostics. This file performs no MMIO writes, no GPIO writes,
+ * no RPMh votes and no clock votes. It only prints what the firmware (ABL)
+ * left behind, so the next stage can be written against facts:
+ *   - TLMM config/IO of GPIO 0..10 in three tiles (which tile holds which pin)
+ *   - GCC clock vote word and the QUPV3 wrapper0 / SE0 bits
+ *   - SE0 (0x880000) firmware protocol, only if its clocks are already on
+ *
+ * Device tree facts (surya): spi2.0 "NVT-ts-spi" on 880000.spi, reset GPIO 8,
+ * irq GPIO 9 (edge), 8 MHz max, supplies touch_lab/touch_ibb/touch_vddio.
+ *
+ * Enable with boot-arg sweettouchnvt=1 (and keep sweettouch=0 so the Goodix
+ * probe for sweet stays off). Delay: sweettouchdelay=<seconds>, default 45.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+void sweet_touch_nvt_init(void);
+
+#define NVT_SE_PA        0x00880000u
+#define NVT_GCC_PA       0x00100000u
+#define NVT_TLMM_N_PA    0x03900000u
+#define NVT_TLMM_W_PA    0x03500000u
+#define NVT_TLMM_S_PA    0x03d00000u
+#define NVT_GCC_VOTE     0x5200cu
+/* wrapper0 on this SoC family: M_AHB 6, S_AHB 7, CORE 8, CORE_2X 9, SE0 10. */
+#define NVT_WRAP0_MASK   0x000007c0u
+#define NVT_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define NVT_GPIO_IO(n)   (NVT_GPIO_CFG(n) + 4u)
+
+#define SE_STATUS        0x040u
+#define SE_FW            0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_CMD           0x600u
+#define SE_IRQ           0x610u
+#define SE_HW_TX         0xe24u
+#define SE_HW_RX         0xe28u
+#define SE_IOS           0x908u
+
+static int nvt_sleep_chan;
+static bool nvt_started;
+
+static uint32_t
+nvt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+nvt_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&nvt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static const char *
+nvt_proto(uint32_t fw)
+{
+	switch ((fw >> 8) & 0xffu) {
+	case 0:
+		return "none";
+	case 1:
+		return "SPI";
+	case 2:
+		return "UART";
+	case 3:
+		return "I2C";
+	default:
+		return "other";
+	}
+}
+
+static void
+nvt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET NVT: stage 1 (read-only) starting in %u s\n", delay_s);
+	nvt_wait(delay_s * 1000u);
+
+	vm_offset_t gcc = ml_io_map(NVT_GCC_PA, 0x60000);
+	vm_offset_t tn = ml_io_map(NVT_TLMM_N_PA, 0x10000);
+	vm_offset_t tw = ml_io_map(NVT_TLMM_W_PA, 0x10000);
+	vm_offset_t ts = ml_io_map(NVT_TLMM_S_PA, 0x10000);
+	if (!gcc || !tn || !tw || !ts) {
+		printf("SWEET NVT: MMIO mapping failed\n");
+		goto out;
+	}
+
+	for (unsigned pin = 0; pin <= 10; ++pin) {
+		printf("SWEET NVT: gpio%u cfg/io N=%#x/%#x W=%#x/%#x S=%#x/%#x\n", pin,
+		    nvt_rd(tn, NVT_GPIO_CFG(pin)), nvt_rd(tn, NVT_GPIO_IO(pin)),
+		    nvt_rd(tw, NVT_GPIO_CFG(pin)), nvt_rd(tw, NVT_GPIO_IO(pin)),
+		    nvt_rd(ts, NVT_GPIO_CFG(pin)), nvt_rd(ts, NVT_GPIO_IO(pin)));
+	}
+
+	uint32_t vote = nvt_rd(gcc, NVT_GCC_VOTE);
+	printf("SWEET NVT: GCC vote=%#x wrap0 m_ahb=%u s_ahb=%u core=%u core2x=%u se0=%u\n",
+	    vote, (vote >> 6) & 1u, (vote >> 7) & 1u, (vote >> 8) & 1u,
+	    (vote >> 9) & 1u, (vote >> 10) & 1u);
+
+	if ((vote & NVT_WRAP0_MASK) != NVT_WRAP0_MASK) {
+		printf("SWEET NVT: wrapper0/SE0 clocks are off; SE0 not touched (stage 2 must vote them)\n");
+		goto out;
+	}
+
+	vm_offset_t se = ml_io_map(NVT_SE_PA, 0x4000);
+	if (!se) {
+		printf("SWEET NVT: SE0 mapping failed\n");
+		goto out;
+	}
+	uint32_t fw = nvt_rd(se, SE_FW);
+	printf("SWEET NVT: se0 fw=%#x proto=%s status=%#x clk_sel=%#x hw_tx=%#x hw_rx=%#x\n",
+	    fw, nvt_proto(fw), nvt_rd(se, SE_STATUS), nvt_rd(se, SE_CLK_SEL),
+	    nvt_rd(se, SE_HW_TX), nvt_rd(se, SE_HW_RX));
+	printf("SWEET NVT: se0 cmd=%#x irq=%#x ios=%#x\n",
+	    nvt_rd(se, SE_CMD), nvt_rd(se, SE_IRQ), nvt_rd(se, SE_IOS));
+out:
+	printf("SWEET NVT: stage 1 done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_nvt_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (nvt_started) {
+		return;
+	}
+	nvt_started = true;
+	(void)PE_parse_boot_argn("sweettouchnvt", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(nvt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET NVT: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
