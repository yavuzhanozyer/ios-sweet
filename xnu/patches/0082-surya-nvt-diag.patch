+/*
+ * SURYA (Poco X3 NFC) Novatek NVT-ts-spi bring-up, stage 2.
+ *
+ * Boot-arg sweettouchnvt=<mode> (keep sweettouch=0 so sweet's Goodix probe
+ * stays off). Delay before starting: sweettouchdelay=<seconds>, default 45.
+ *   1  read-only: TLMM pins, GCC vote word, GCC wrapper0/wrapper1 registers
+ *   2  mode 1, then vote the wrapper0 + SE0 clock bits and dump GCC again
+ *   3  mode 2, then (after a pause so the log reaches disk) read SE0 registers
+ * Nothing here touches the touch IC, its reset/IRQ GPIOs, pin muxes, RPMh
+ * rails or RCG configuration. The only write is the clock vote in mode 2/3.
+ *
+ * Stage 1 facts (boot6): GPIO0-3 live in the SOUTH tile, 4-10 in NORTH; all
+ * of GPIO0-3 are plain GPIO inputs (not muxed to QUP); reset GPIO8 is an
+ * input pulled down (IC held in reset); GCC vote 0x41000000 (wrapper0 off).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+void sweet_touch_nvt_init(void);
+
+#define NVT_SE_PA        0x00880000u
+#define NVT_GCC_PA       0x00100000u
+#define NVT_TLMM_N_PA    0x03900000u
+#define NVT_TLMM_S_PA    0x03d00000u
+#define NVT_GCC_VOTE     0x5200cu
+/* Same layout as sweet's wrapper1 bits 18-21 + 23: wrapper0 is bits 6-9,
+ * its SE0 bit 10. Verified only by the dump this stage prints. */
+#define NVT_WRAP0_MASK   0x000007c0u
+#define NVT_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define NVT_GPIO_IO(n)   (NVT_GPIO_CFG(n) + 4u)
+
+#define SE_STATUS        0x040u
+#define SE_FW            0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_CMD           0x600u
+#define SE_IRQ           0x610u
+#define SE_HW_TX         0xe24u
+#define SE_HW_RX         0xe28u
+#define SE_IOS           0x908u
+
+static int nvt_sleep_chan;
+static bool nvt_started;
+static int nvt_mode;
+
+static uint32_t
+nvt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+nvt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+nvt_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&nvt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static const char *
+nvt_proto(uint32_t fw)
+{
+	switch ((fw >> 8) & 0xffu) {
+	case 0:
+		return "none";
+	case 1:
+		return "SPI";
+	case 2:
+		return "UART";
+	case 3:
+		return "I2C";
+	default:
+		return "other";
+	}
+}
+
+/* Four registers per line, read-only. */
+static void
+nvt_dump(vm_offset_t gcc, const char *tag, uint32_t from, uint32_t to)
+{
+	for (uint32_t off = from; off < to; off += 16u) {
+		printf("SWEET NVT: %s %#x: %08x %08x %08x %08x\n", tag, off,
+		    nvt_rd(gcc, off), nvt_rd(gcc, off + 4u),
+		    nvt_rd(gcc, off + 8u), nvt_rd(gcc, off + 12u));
+	}
+}
+
+static void
+nvt_gcc_dump(vm_offset_t gcc, const char *tag)
+{
+	printf("SWEET NVT: %s vote=%#x wrap0 bits6-10=%#x wrap1 bits18-23=%#x\n", tag,
+	    nvt_rd(gcc, NVT_GCC_VOTE), (nvt_rd(gcc, NVT_GCC_VOTE) >> 6) & 0x1fu,
+	    (nvt_rd(gcc, NVT_GCC_VOTE) >> 18) & 0x3fu);
+	nvt_dump(gcc, tag, 0x17000u, 0x17050u);  /* wrapper0 block */
+	nvt_dump(gcc, tag, 0x17140u, 0x17160u);  /* wrapper0 local S1 slot */
+	nvt_dump(gcc, tag, 0x18000u, 0x18030u);  /* wrapper1 block (sweet: known) */
+	nvt_dump(gcc, tag, 0x18140u, 0x18160u);  /* wrapper1 S1 = sweet SE7 */
+}
+
+static void
+nvt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET NVT: stage 2 mode %d starting in %u s\n", nvt_mode, delay_s);
+	nvt_wait(delay_s * 1000u);
+
+	vm_offset_t gcc = ml_io_map(NVT_GCC_PA, 0x60000);
+	vm_offset_t tn = ml_io_map(NVT_TLMM_N_PA, 0x10000);
+	vm_offset_t ts = ml_io_map(NVT_TLMM_S_PA, 0x10000);
+	if (!gcc || !tn || !ts) {
+		printf("SWEET NVT: MMIO mapping failed\n");
+		goto out;
+	}
+	for (unsigned pin = 0; pin <= 3; ++pin) {
+		printf("SWEET NVT: gpio%u S cfg/io=%#x/%#x\n", pin,
+		    nvt_rd(ts, NVT_GPIO_CFG(pin)), nvt_rd(ts, NVT_GPIO_IO(pin)));
+	}
+	for (unsigned pin = 8; pin <= 9; ++pin) {
+		printf("SWEET NVT: gpio%u N cfg/io=%#x/%#x\n", pin,
+		    nvt_rd(tn, NVT_GPIO_CFG(pin)), nvt_rd(tn, NVT_GPIO_IO(pin)));
+	}
+	nvt_gcc_dump(gcc, "before");
+	if (nvt_mode < 2) {
+		goto out;
+	}
+
+	printf("SWEET NVT: voting wrapper0+SE0 clocks (mask %#x)\n", NVT_WRAP0_MASK);
+	nvt_wr(gcc, NVT_GCC_VOTE, nvt_rd(gcc, NVT_GCC_VOTE) | NVT_WRAP0_MASK);
+	nvt_wait(5);
+	nvt_gcc_dump(gcc, "after");
+	if (nvt_mode < 3) {
+		goto out;
+	}
+
+	/* Let the persistent log reach disk: if the SE0 read hangs, keep the dump. */
+	printf("SWEET NVT: pausing 10 s before reading SE0\n");
+	nvt_wait(10000);
+	vm_offset_t se = ml_io_map(NVT_SE_PA, 0x4000);
+	if (!se) {
+		printf("SWEET NVT: SE0 mapping failed\n");
+		goto out;
+	}
+	uint32_t fw = nvt_rd(se, SE_FW);
+	printf("SWEET NVT: se0 fw=%#x proto=%s status=%#x clk_sel=%#x hw_tx=%#x hw_rx=%#x\n",
+	    fw, nvt_proto(fw), nvt_rd(se, SE_STATUS), nvt_rd(se, SE_CLK_SEL),
+	    nvt_rd(se, SE_HW_TX), nvt_rd(se, SE_HW_RX));
+	printf("SWEET NVT: se0 cmd=%#x irq=%#x ios=%#x\n",
+	    nvt_rd(se, SE_CMD), nvt_rd(se, SE_IRQ), nvt_rd(se, SE_IOS));
+out:
+	printf("SWEET NVT: stage 2 done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_nvt_init(void)
+{
+	thread_t thread;
+	if (nvt_started) {
+		return;
+	}
+	nvt_started = true;
+	(void)PE_parse_boot_argn("sweettouchnvt", &nvt_mode, sizeof(nvt_mode));
+	if (nvt_mode <= 0) {
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(nvt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET NVT: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
